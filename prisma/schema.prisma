generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserProvider {
  google
  local

  @@map("user_provider")
}

enum UserRole {
  user
  admin
  teacher

  @@map("user_role")
}

enum UserStatusType {
  active
  banned
  pending

  @@map("user_status_type")
}

enum UserWordStatus {
  new
  learning
  familiar
  mastered
  forgotten

  @@map("user_word_status")
}

enum QueueStatus {
  pending
  in_progress
  completed

  @@map("queue_status")
}

enum SessionType {
  flashcard
  multiple_choice
  typing
  mixed

  @@map("session_type")
}

enum SourceType {
  daily_queue
  word_list
  manual

  @@map("source_type")
}

enum SessionStatus {
  in_progress
  completed
  abandoned

  @@map("session_status")
}

enum QuestionType {
  definition_to_word
  word_to_definition
  fill_blank
  audio_to_word

  @@map("question_type")
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           Int            @id @default(autoincrement())
  name         String?        @db.VarChar(100)
  email        String         @unique @db.VarChar(255)
  passwordHash String?        @map("password_hash") @db.VarChar(255)
  image        String?        @db.VarChar(500)
  provider     UserProvider   @default(local)
  role         UserRole       @default(user)
  status       UserStatusType @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  userWords         UserWord[]
  wordLists         WordList[]
  dailyReviewQueues DailyReviewQueue[]
  reviewSessions    ReviewSession[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent") @db.VarChar(500)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model Word {
  id        Int       @id @default(autoincrement())
  word      String    @unique @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  wordMeanings WordMeaning[]

  @@map("words")
}

model WordMeaning {
  id           Int       @id @default(autoincrement())
  wordId       Int       @map("word_id")
  definition   String
  vnDefinition String    @default("") @map("vn_definition")
  partOfSpeech String?   @map("part_of_speech") @db.VarChar(50)
  examples     Json?
  cefrLevel    String?   @map("cefr_level") @db.VarChar(10)
  ukIpa        String?   @map("uk_ipa") @db.VarChar(100)
  usIpa        String?   @map("us_ipa") @db.VarChar(100)
  ukAudioUrl   String?   @map("uk_audio_url") @db.VarChar(500)
  usAudioUrl   String?   @map("us_audio_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")

  word          Word           @relation(fields: [wordId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  userWords     UserWord[]
  wordListItems WordListItem[]

  @@map("word_meanings")
}

model UserWord {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  wordMeaningId  Int             @map("word_meaning_id")
  status         UserWordStatus @default(new)
  addedAt        DateTime       @default(now()) @map("added_at")
  lastReviewedAt DateTime?      @map("last_reviewed_at")
  nextReviewAt   DateTime?      @map("next_review_at")
  totalReviews   Int            @default(0) @map("total_reviews")
  correctCount   Int            @default(0) @map("correct_count")
  incorrectCount Int            @default(0) @map("incorrect_count")
  currentStreak  Int            @default(0) @map("current_streak")
  maxStreak      Int            @default(0) @map("max_streak")
  easeFactor     Decimal        @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  intervalDays   Int            @default(1) @map("interval_days")
  personalNote   String?        @map("personal_note")
  isFavorite     Boolean        @default(false) @map("is_favorite")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  wordMeaning        WordMeaning         @relation(fields: [wordMeaningId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  reviewSessionItems ReviewSessionItem[]

  @@unique([userId, wordMeaningId])
  @@map("user_words")
}

model WordList {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  name        String    @db.VarChar(200)
  description String?
  isPublic    Boolean   @default(false) @map("is_public")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordListItems WordListItem[]

  @@map("word_lists")
}

model WordListItem {
  id            Int       @id @default(autoincrement())
  listId        Int       @map("list_id")
  wordMeaningId Int       @map("word_meaning_id")
  addedAt       DateTime @default(now()) @map("added_at")

  wordList    WordList    @relation(fields: [listId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  wordMeaning WordMeaning @relation(fields: [wordMeaningId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([listId, wordMeaningId])
  @@map("word_list_items")
}

model DailyReviewQueue {
  id             BigInt       @id @default(autoincrement())
  userId         Int          @map("user_id")
  reviewDate     DateTime     @map("review_date") @db.Date
  wordMeaningIds Json?        @map("word_meaning_ids")
  totalWords     Int          @default(0) @map("total_words")
  newWords       Int          @default(0) @map("new_words")
  reviewWords    Int          @default(0) @map("review_words")
  status         QueueStatus  @default(pending)
  completedWords Int          @default(0) @map("completed_words")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewDate])
  @@map("daily_review_queue")
}

model ReviewSession {
  id               BigInt         @id @default(autoincrement())
  userId           Int            @map("user_id")
  sessionType      SessionType    @default(flashcard) @map("session_type")
  sourceType       SourceType     @default(daily_queue) @map("source_type")
  sourceId         BigInt?        @map("source_id")
  totalQuestions   Int            @default(0) @map("total_questions")
  correctAnswers   Int            @default(0) @map("correct_answers")
  incorrectAnswers Int            @default(0) @map("incorrect_answers")
  skipped          Int            @default(0)
  scorePercent     Decimal?       @map("score_percent") @db.Decimal(5, 2)
  durationSeconds  Int?           @map("duration_seconds")
  avgTimePerWordMs Int?           @map("avg_time_per_word_ms")
  status           SessionStatus  @default(in_progress)
  startedAt        DateTime       @default(now()) @map("started_at")
  finishedAt       DateTime?      @map("finished_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewSessionItems ReviewSessionItem[]

  @@map("review_sessions")
}

// Maps any inflected / variant form to the canonical Word row.
// Populated automatically when the crawler resolves a searched term
// to a different canonical headword on Cambridge.
model WordAlias {
  id            Int      @id @default(autoincrement())
  alias         String   @unique @db.VarChar(100) // e.g. "went", "sizes", "bought"
  canonicalWord String   @map("canonical_word") @db.VarChar(100) // e.g. "go", "size", "buy"
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("word_aliases")
}

model ReviewSessionItem {
  id             BigInt        @id @default(autoincrement())
  sessionId      BigInt        @map("session_id")
  userWordId     Int           @map("user_word_id")
  questionType   QuestionType? @default(word_to_definition) @map("question_type")
  userAnswer     String?       @map("user_answer")
  isCorrect      Boolean?      @map("is_correct")
  timeTakenMs    Int?          @map("time_taken_ms")
  streakBefore   Int?          @map("streak_before")
  easeBefore     Decimal?      @map("ease_before") @db.Decimal(4, 2)
  intervalBefore Int?          @map("interval_before")
  streakAfter    Int?          @map("streak_after")
  easeAfter      Decimal?      @map("ease_after") @db.Decimal(4, 2)
  intervalAfter  Int?          @map("interval_after")
  answeredAt     DateTime?     @default(now()) @map("answered_at")

  reviewSession ReviewSession @relation(fields: [sessionId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userWord      UserWord      @relation(fields: [userWordId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("review_session_items")
}
