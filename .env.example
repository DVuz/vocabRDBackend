# Local development database
DATABASE_URL_DEV="postgresql://USER:PASSWORD@localhost:5432/postgres?schema=vocab"

# Production database (Supabase connection pooling)
DATABASE_URL_PROD="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Direct connection - used for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# JWT
JWT_ACCESS_SECRET=change_me
JWT_ACCESS_EXPIRES_IN=30d

JWT_REFRESH_SECRET=change_me
JWT_REFRESH_EXPIRES_IN=7d

JWT_SECRET=change_me

# Server
PORT=3000
NODE_ENV=development

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Supabase
SUPABASE_URL=your_supabase_password
